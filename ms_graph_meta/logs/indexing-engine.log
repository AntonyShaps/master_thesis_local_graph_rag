2026-05-24 14:55:33.0455 - DEBUG - graphrag.api.index - [{'id': '907b7c9f-5de6-457a-a955-e6031d445244', 'human_readable_id': 0, 'community': 0, 'level': 0, 'parent': -1, 'children': [2, 3], 'title': 'Community 0', 'entity_ids': ['2f6c52ff-96b0-40a6-a6e3-b4280230a89c', '64787de6-8851-45fd-9561-4d86fa0c90e1', '6187c15f-2ab2-4be0-aa7c-147f13086b69', '0db13ce3-fe0a-4637-8554-82d1a0495f47', '78fa6c95-1706-4748-ba11-1170a9626a45', '17b153c1-d8ee-434d-a5d7-c38d07784e9f', '84eca84d-7530-4666-b05f-032b8dd48752', 'de581d07-1e85-4ce8-ae96-a7ac2b963d9d', '342d4ed0-1cd2-4ffc-9c08-3120df4a5867', 'ce726c78-5685-42de-ac21-06ad4e1150b0', '1b13a9e4-b82a-4ad1-90b0-0650a03e6f2e', '5ee22421-1961-40d3-9469-55a0731e2ae0', '5d4f539e-1067-4c2d-ba95-f4f2df204098', 'f8b9f720-4e9e-45fe-9e06-864ee1a9139d', 'b518a1d1-3bf1-42d0-8e90-fe6f60410ad9', '5ab12d70-7f96-430a-a8d1-63c973d3d837', 'e34d07c5-a648-40b3-963b-68c9cd8561b3', '134a38ac-6734-4dbc-a5ec-bf65ad43ac87', '14aa0573-0db4-4bda-ae10-03c25fc19624', '383281cd-e05d-47fa-a2bd-a2875b1bafcc'], 'relationship_ids': ['0aa2ee7d-8035-4c98-a904-56ce058e5453', '1607f36b-db26-48f3-bc7c-22d545e7b7e2', '34660f5f-2cde-42ae-b6c9-0fbb9434fdef', '36ea32f8-742c-4645-8d3e-b26e03ac1fa5', '40d266e2-b7dd-4b77-ba2f-5b634744adae', '4c9dd59a-b34b-4ffb-b9d6-75b1e6a59d97', '5263271e-4864-4074-aa86-375ef6f1f431', '534717e7-2a96-449b-8887-f248b6944699', '5ee5b5e6-bdb8-4076-ba87-7dda83ff44ed', '5f57290f-f1aa-451d-8770-66658514f0e8', '6f5f1128-6a04-4e6a-a2d3-b2402bd0c631', '7edcaf8d-5916-4270-a9f4-efcea48ac751', '8a9680e7-a799-4641-aefc-58401bdd8f3f', '97849946-b84f-4370-a67e-e11c4540041c', '99ded198-050b-47dc-b6b0-bc0fa2d5a124', 'aef729d9-20d5-4718-92d8-cec79c163b6d', 'c02cf694-d081-4c8f-a4a8-61115b3af52d', 'c4018c0a-bcfd-48e6-b613-583ba829761a', 'c9cce6fa-3e4a-4fbe-a08d-f76981b931ad', 'ccde709c-bfd4-4dff-b57e-b3c458e4e832', 'e3d9e647-a30b-4153-b212-67cfe9737550', 'e8fc2f8f-8915-4775-bc19-e7a1795e48af', 'ee38f66f-c3ac-49b3-8d5a-4232906308bd', 'fecead13-327c-4536-a7b6-fa66